<header class="cabecera-pagina">
  <div>
    <!-- Esta variable "seccion" viene de res.locals.seccion definido en el middleware del router -->
    <p class="etiqueta"><%= seccion %></p> 
    <h1><%= titulo %></h1>
  </div>
  <a class="boton" href="/reservas/nueva">Nueva reserva</a>
</header>

<% if (reservas.length === 0) { %>
  <!-- Estado vacío alternativo -->
  <section class="estado">
    <p>En este momento no hay reservas registradas en el sistema. ¡Sé el primero en reservar una sala de estudio!</p>
  </section>
<% } else { %>
  <!-- Listado de reservas -->
  <section class="grilla" aria-label="Listado de reservas">
    <% reservas.forEach((reserva) => { %>
      <article class="tarjeta">
        <p class="etiqueta"><%= reserva.sala %></p>
        <h2><%= reserva.estudiante %></h2>
        <p><strong>Fecha:</strong> <%= reserva.fecha %></p>
        <p><strong>Turno:</strong> <%= reserva.turno %></p>
        <a href="/reservas/<%= reserva.id %>">Ver detalle de la reserva</a>
      </article>
    <% }) %>
  </section>
<% } %>